      "description": "leading and trailing '-' are trimmed",
      "section": "vv-06 §4.2",
      "input": {
        "hostname": "--router--"
      },
      "output": {
        "name": "router"
      }
    },
    {
      "description": "runs of '-' are collapsed",
      "section": "vv-06 §4.2",
      "input": {
        "hostname": "a__b--c"
      },
      "output": {
        "name": "a-b-c"
      }
    },
    {
      "description": "a non-ASCII letter is one code point, so one '-', merged with the next '-'",
      "section": "vv-06 §4.2",
      "input": {
        "hostname": "café-box"
      },
      "output": {
        "name": "caf-box"
      }
    },
    {
      "description": "non-ASCII uppercase is replaced, not lowercased",
      "section": "vv-06 §4.2",
      "input": {
        "hostname": "ÉCOLE"
      },
      "output": {
        "name": "cole"
      }
    },
    {
      "description": "a code point outside the BMP is one '-'",
      "section": "vv-06 §4.2",
      "input": {
        "hostname": "home😀server"
      },
      "output": {
        "name": "home-server"
      }
    },
    {
      "description": "nothing remains: no own name",
      "section": "vv-06 §4.2",
